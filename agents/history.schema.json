{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zigide.dev/schemas/agent-history-v1.json",
  "title": "Zigide human-AI interaction history",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "entries"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "project": {
      "const": "zigide"
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "timestamp",
        "kind",
        "summary",
        "intentTags",
        "conversation",
        "research",
        "artifacts",
        "decisions",
        "verification",
        "publication"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "timestamp": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "intentTags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "conversation": {
          "type": "string",
          "pattern": "^conversations/[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{2}-[0-9]{2}-[0-9]{2}-[0-9a-f-]{36}\\.md$"
        },
        "research": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^researches/[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{2}-[0-9]{2}-[0-9]{2}-[0-9a-f-]{36}\\.md$"
            },
            {
              "type": "null"
            }
          ]
        },
        "artifacts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "decisions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "verification": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "publication": {
          "type": "object",
          "additionalProperties": false,
          "required": ["committed", "pushed"],
          "properties": {
            "committed": {
              "type": "boolean"
            },
            "pushed": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
